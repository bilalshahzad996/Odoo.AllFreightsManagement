<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_freight_eta_approaching" model="mail.template">
            <field name="name">Freight: ETA Approaching (3 Days)</field>
            <field name="model_id" ref="model_freight_shipment"/>
            <field name="subject">Shipment {{ object.name }} — ETA in 3 Days ({{ object.eta }})</field>
            <field name="email_to">{{ object.customer_id.email or '' }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
    <p>Dear {{ object.customer_id.name }},</p>
    <p>
        We would like to inform you that your shipment
        <strong>{{ object.name }}</strong> is expected to arrive in
        <strong>3 days</strong>.
    </p>
    <table style="border-collapse: collapse; width: 100%; margin: 16px 0;">
        <tr>
            <td style="padding: 6px 12px; background: #f5f5f5; font-weight: bold; width: 200px;">Shipment Reference</td>
            <td style="padding: 6px 12px;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 6px 12px; background: #f5f5f5; font-weight: bold;">Origin</td>
            <td style="padding: 6px 12px;">{{ object.origin_port_id.name or '' }}</td>
        </tr>
        <tr>
            <td style="padding: 6px 12px; background: #f5f5f5; font-weight: bold;">Destination</td>
            <td style="padding: 6px 12px;">{{ object.destination_port_id.name or '' }}</td>
        </tr>
        <tr>
            <td style="padding: 6px 12px; background: #f5f5f5; font-weight: bold;">Expected Arrival (ETA)</td>
            <td style="padding: 6px 12px;"><strong>{{ object.eta }}</strong></td>
        </tr>
        {% if object.shipping_line_id %}
        <tr>
            <td style="padding: 6px 12px; background: #f5f5f5; font-weight: bold;">Carrier</td>
            <td style="padding: 6px 12px;">{{ object.shipping_line_id.name }}</td>
        </tr>
        {% endif %}
        {% if object.master_bl %}
        <tr>
            <td style="padding: 6px 12px; background: #f5f5f5; font-weight: bold;">Master B/L</td>
            <td style="padding: 6px 12px;">{{ object.master_bl }}</td>
        </tr>
        {% endif %}
    </table>
    <p>
        Please make the necessary arrangements for timely pickup or customs clearance.
    </p>
    <p>
        If you have any questions, please do not hesitate to contact us.
    </p>
    <p>
        Kind regards,<br/>
        {{ object.company_id.name }}
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_freight_shipment_import" model="ir.sequence">
        <field name="name">Freight Import Shipment</field>
        <field name="code">freight.shipment.import</field>
        <field name="prefix">IMP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_freight_shipment_export" model="ir.sequence">
        <field name="name">Freight Export Shipment</field>
        <field name="code">freight.shipment.export</field>
        <field name="prefix">EXP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_freight_shipment" model="ir.sequence">
        <field name="name">Freight Shipment</field>
        <field name="code">freight.shipment</field>
        <field name="prefix">SHP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>

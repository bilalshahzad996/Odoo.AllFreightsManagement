        <field name="package_count">340</field>
        <field name="gross_weight">24800</field>
        <field name="volume">67.0</field>
        <field name="hs_code">4407.29</field>
        <field name="commodity_description">Tropical Hardwood Lumber</field>
        <field name="country_of_origin_id" ref="base.sg"/>
        <field name="customs_value">48000.0</field>
        <field name="tracking_status">arrived</field>
    </record>

    <record id="demo_container_3b" model="freight.container">
        <field name="name">MSKU9876544</field>

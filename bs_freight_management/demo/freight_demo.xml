        <field name="amount">2750.0</field>
        <field name="currency_id" ref="base.USD"/>
    </record>

    <record id="demo_charge_3b" model="freight.charge">
        <field name="shipment_id" ref="demo_shipment_3"/>
        <field name="charge_type_id" ref="charge_type_thc"/>
        <field name="name">THC Felixstowe</field>
        <field name="amount">310.0</field>
        <field name="currency_id" ref="base.USD"/>
    </record>

    <record id="demo_charge_3c" model="freight.charge">
        <field name="shipment_id" ref="demo_shipment_3"/>

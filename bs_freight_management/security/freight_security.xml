<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_freight" model="res.groups.privilege">
        <field name="name">Freight Forwarding</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_freight_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_freight"/>
        <field name="comment">Create and manage shipments and charges.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_freight_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_freight"/>
        <field name="comment">Full access including master data configuration.</field>
        <field name="implied_ids" eval="[(4, ref('group_freight_user'))]"/>
    </record>

    <data noupdate="1">
        <record id="group_freight_manager" model="res.groups">
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- ===== Multi-company record rules ===== -->
        <record id="rule_freight_shipment_company" model="ir.rule">
            <field name="name">Freight Shipment: Multi-company</field>
            <field name="model_id" ref="freight_forwarding.model_freight_shipment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_freight_container_company" model="ir.rule">
            <field name="name">Freight Container: Multi-company</field>
            <field name="model_id" ref="freight_forwarding.model_freight_container"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_freight_charge_company" model="ir.rule">
            <field name="name">Freight Charge: Multi-company</field>
            <field name="model_id" ref="freight_forwarding.model_freight_charge"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_freight_shipment_leg_company" model="ir.rule">
            <field name="name">Freight Shipment Leg: Multi-company</field>
            <field name="model_id" ref="freight_forwarding.model_freight_shipment_leg"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_freight_tariff_company" model="ir.rule">
            <field name="name">Freight Tariff: Multi-company</field>
            <field name="model_id" ref="freight_forwarding.model_freight_tariff"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_freight_shipping_line_company" model="ir.rule">
            <field name="name">Freight Shipping Line: Multi-company</field>
            <field name="model_id" ref="freight_forwarding.model_freight_shipping_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_freight_port_company" model="ir.rule">
            <field name="name">Freight Port: Multi-company</field>
            <field name="model_id" ref="freight_forwarding.model_freight_port"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>

</odoo>

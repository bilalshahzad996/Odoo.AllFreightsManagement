<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_freight_charge_type_list" model="ir.ui.view">
        <field name="name">freight.charge.type.list</field>
        <field name="model">freight.charge.type</field>
        <field name="arch" type="xml">
            <list string="Charge Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="income_account_id"
                       groups="freight_forwarding.group_freight_manager"/>
                <field name="expense_account_id"
                       groups="freight_forwarding.group_freight_manager"/>
            </list>
        </field>
    </record>

    <record id="view_freight_charge_type_form" model="ir.ui.view">
        <field name="name">freight.charge.type.form</field>
        <field name="model">freight.charge.type</field>
        <field name="arch" type="xml">
            <form string="Charge Type">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Accounting"
                               groups="freight_forwarding.group_freight_manager">
                            <field name="income_account_id"/>
                            <field name="expense_account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_freight_charge_type" model="ir.actions.act_window">
        <field name="name">Charge Types</field>
        <field name="res_model">freight.charge.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

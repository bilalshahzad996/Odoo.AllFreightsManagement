<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ FORM ============ -->
    <record id="view_freight_shipment_form" model="ir.ui.view">
        <field name="name">freight.shipment.form</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <!-- Main workflow buttons -->
                    <button name="action_book" type="object" string="Confirm Booking"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_in_transit" type="object" string="Set In Transit"
                            class="oe_highlight" invisible="state != 'booked'"/>
                    <button name="action_arrived" type="object" string="Mark Arrived"
                            class="oe_highlight" invisible="state != 'in_transit'"/>
                    <button name="action_cleared" type="object" string="Mark Cleared"
                            class="oe_highlight" invisible="state != 'arrived'"/>
                    <button name="action_delivered" type="object" string="Mark Delivered"
                            class="oe_highlight" invisible="state != 'cleared'"/>

                    <!-- Approval buttons (user submits, manager approves/refuses) -->
                    <button name="action_submit_approval" type="object"
                            string="Submit for Approval"
                            invisible="approval_state not in ('not_required', 'refused')"
                            groups="freight_forwarding.group_freight_user"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight"
                            invisible="approval_state != 'pending'"
                            groups="freight_forwarding.group_freight_manager"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="approval_state != 'pending'"
                            groups="freight_forwarding.group_freight_manager"/>

                    <!-- Tariff button -->
                    <button name="action_apply_tariff" type="object"
                            string="Apply Tariff Rates"
                            invisible="state in ('draft', 'cancelled')"
                            groups="freight_forwarding.group_freight_manager"/>

                    <!-- Demurrage charge button -->
                    <button name="action_create_demurrage_charge" type="object"
                            string="Create Demurrage Charge"
                            invisible="demurrage_days == 0"
                            groups="freight_forwarding.group_freight_manager"/>

                    <!-- Invoicing buttons -->
                    <button name="action_create_invoice" type="object"
                            string="Create Invoice"
                            invisible="state in ('draft', 'cancelled')"/>
                    <button name="action_create_vendor_bills" type="object"
                            string="Create Vendor Bills"
                            invisible="state in ('draft', 'cancelled')"/>

                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state in ('draft', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('delivered', 'cancelled')"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,booked,in_transit,arrived,cleared,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_containers" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="container_count" widget="statinfo"
                                   string="Containers"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo"
                                   string="Invoices"/>
                        </button>
                        <button name="action_view_vendor_bills" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="vendor_bill_count == 0">
                            <field name="vendor_bill_count" widget="statinfo"
                                   string="Vendor Bills"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <!-- Approval state banner -->
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="approval_state != 'pending'">
                        <strong>Pending Manager Approval</strong> — This shipment is
                        awaiting approval before it can be booked.
                    </div>
                    <div class="alert alert-danger mb-0" role="alert"
                         invisible="approval_state != 'refused'">
                        <strong>Approval Refused</strong> — Please review the charges
                        and resubmit for approval.
                    </div>
                    <group>
                        <group string="Shipment">
                            <field name="shipment_type"/>
                            <field name="transport_mode"/>
                            <field name="shipping_line_id"/>
                            <field name="booking_ref"/>
                            <field name="approval_state" widget="badge"
                                   decoration-warning="approval_state == 'pending'"
                                   decoration-success="approval_state == 'approved'"
                                   decoration-danger="approval_state == 'refused'"
                                   invisible="approval_state == 'not_required'"/>
                        </group>
                        <group string="Parties">
                            <field name="customer_id"/>
                            <field name="shipper_id"/>
                            <field name="consignee_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Routing">
                            <field name="origin_port_id"/>
                            <field name="destination_port_id"/>
                            <field name="incoterm_id"/>
                        </group>
                        <group string="Schedule">
                            <field name="date_booked"/>
                            <field name="etd"/>
                            <field name="eta"/>
                            <field name="date_arrived" readonly="1"/>
                            <field name="date_delivered" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Documents">
                            <field name="master_bl"/>
                            <field name="house_bl"/>
                            <field name="customs_declaration_no"/>
                        </group>
                        <group string="Costing">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="total_charges"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="demurrage_days" readonly="1"/>
                            <field name="demurrage_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Legs" name="legs">
                            <field name="leg_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="leg_type"/>
                                    <field name="origin_port_id"/>
                                    <field name="destination_port_id"/>
                                    <field name="shipping_line_id"/>
                                    <field name="vessel_name"/>
                                    <field name="voyage_no"/>
                                    <field name="etd"/>
                                    <field name="eta"/>
                                    <field name="bl_number"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Containers" name="containers">
                            <field name="container_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="container_type"/>
                                    <field name="seal_number"/>
                                    <field name="package_count"/>
                                    <field name="gross_weight"/>
                                    <field name="volume"/>
                                    <field name="hs_code"/>
                                    <field name="commodity_description"/>
                                    <field name="country_of_origin_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Charges" name="charges">
                            <field name="charge_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="charge_type_id"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                    <field name="amount_company" string="Company Currency"
                                           sum="Total"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_charges"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ LIST ============ -->
    <record id="view_freight_shipment_list" model="ir.ui.view">
        <field name="name">freight.shipment.list</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <list string="Shipments"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'delivered'"
                  decoration-info="state == 'in_transit'">
                <field name="name"/>
                <field name="shipment_type"/>
                <field name="transport_mode"/>
                <field name="customer_id"/>
                <field name="shipping_line_id"/>
                <field name="origin_port_id"/>
                <field name="destination_port_id"/>
                <field name="incoterm_id"/>
                <field name="etd"/>
                <field name="eta"/>
                <field name="container_count" string="Cntrs"/>
                <field name="total_charges" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="approval_state" widget="badge"
                       decoration-warning="approval_state == 'pending'"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'refused'"
                       column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'delivered'"
                       decoration-info="state == 'in_transit'"
                       decoration-warning="state == 'arrived'"/>
            </list>
        </field>
    </record>

    <!-- ============ KANBAN ============ -->
    <record id="view_freight_shipment_kanban" model="ir.ui.view">
        <field name="name">freight.shipment.kanban</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="approval_state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div>
                                <field name="shipment_type"/> /
                                <field name="transport_mode"/>
                            </div>
                            <div>
                                <i class="fa fa-anchor me-1" title="Route"/>
                                <field name="origin_port_id"/>
                                <i class="fa fa-long-arrow-right mx-1" title="to"/>
                                <field name="destination_port_id"/>
                            </div>
                            <div t-if="record.customer_id.raw_value">
                                <i class="fa fa-user me-1" title="Customer"/>
                                <field name="customer_id"/>
                            </div>
                            <div t-if="record.approval_state.raw_value == 'pending'"
                                 class="text-warning mt-1">
                                <i class="fa fa-clock-o me-1" title="Pending Approval"/>Pending Approval
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <span><i class="fa fa-calendar me-1" title="ETA"/><field name="eta"/></span>
                                <strong><field name="total_charges"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============ GRAPH ============ -->
    <record id="view_freight_shipment_graph" model="ir.ui.view">
        <field name="name">freight.shipment.graph</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <graph string="Freight Analysis" type="bar">
                <field name="transport_mode"/>
                <field name="total_charges" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============ PIVOT ============ -->
    <record id="view_freight_shipment_pivot" model="ir.ui.view">
        <field name="name">freight.shipment.pivot</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <pivot string="Freight Analysis" display_quantity="true">
                <field name="shipment_type" type="row"/>
                <field name="transport_mode" type="col"/>
                <field name="total_charges" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="view_freight_shipment_search" model="ir.ui.view">
        <field name="name">freight.shipment.search</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference"/>
                <field name="master_bl"/>
                <field name="house_bl"/>
                <field name="customs_declaration_no"/>
                <field name="customer_id"/>
                <field name="shipping_line_id"/>
                <field name="origin_port_id"/>
                <field name="destination_port_id"/>
                <field name="container_ids" string="Container No."/>
                <separator/>
                <filter name="import" string="Import"
                        domain="[('shipment_type', '=', 'import')]"/>
                <filter name="export" string="Export"
                        domain="[('shipment_type', '=', 'export')]"/>
                <separator/>
                <filter name="open" string="Open"
                        domain="[('state', 'not in', ('delivered', 'cancelled'))]"/>
                <filter name="in_transit" string="In Transit"
                        domain="[('state', '=', 'in_transit')]"/>
                <filter name="pending_approval" string="Pending Approval"
                        domain="[('approval_state', '=', 'pending')]"/>
                <group>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'shipment_type'}"/>
                    <filter name="group_mode" string="Mode"
                            context="{'group_by': 'transport_mode'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_line" string="Shipping Line"
                            context="{'group_by': 'shipping_line_id'}"/>
                    <filter name="group_customer" string="Customer"
                            context="{'group_by': 'customer_id'}"/>
                    <filter name="group_incoterm" string="Incoterms"
                            context="{'group_by': 'incoterm_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="action_freight_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">freight.shipment</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_freight_shipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first shipment job file
            </p>
            <p>
                Track containers, shipping lines, port clearance and
                multi-currency charges for every import / export job.
            </p>
        </field>
    </record>

</odoo>

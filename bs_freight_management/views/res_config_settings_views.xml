<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_freight" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.freight</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Freight Forwarding"
                     string="Freight Forwarding"
                     name="freight_forwarding"
                     groups="freight_forwarding.group_freight_manager">
                    <block title="Approval Workflow" name="freight_approval_block">
                        <setting string="Require Manager Approval"
                                 help="Require Freight Manager approval before booking shipments that exceed the threshold.">
                            <field name="freight_approval_required"/>
                            <div class="content-group mt8"
                                 invisible="not freight_approval_required">
                                <div class="row">
                                    <label for="freight_approval_threshold"
                                           string="Approval Threshold"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="freight_approval_threshold"
                                           class="col-lg-4"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
